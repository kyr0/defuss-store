# Optional overrides; every key is unset by default. Export them in the shell, nothing loads .env automatically.
# Dev/test server port for scripts/serve.ts (default 4178). Playwright expects 4178, so set it only for `npm run dev`.
PORT=
# Chromium binary for Playwright instead of the one installed by `make setup`.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Extra Chromium launch arguments as a JSON array, e.g. ["--no-sandbox"].
PLAYWRIGHT_CHROMIUM_ARGS=
